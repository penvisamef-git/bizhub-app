<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- app links: BizHub links open in the app (needs https://bizhubcambodia.com/.well-known/apple-app-site-association) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bizhubcambodia.com</string>
		<string>applinks:www.bizhubcambodia.com</string>
	</array>
</dict>
</plist>
